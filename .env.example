NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://nfcid:nfcid_dev_password@localhost:5432/nfcid?schema=public
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:5500
TRUST_PROXY=false

JWT_ACCESS_SECRET=replace-with-a-unique-32-character-or-longer-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-unique-32-character-or-longer-refresh-secret
IP_HASH_SALT=replace-with-a-unique-16-character-or-longer-ip-hash-salt

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
MAIL_FROM=NFC-ID <no-reply@nfc-id.com>

DEFAULT_ADMIN_EMAIL=admin@nfc-id.local
DEFAULT_ADMIN_PASSWORD=ReplaceThisWithAStrongAdminPassword!2026
PUBLIC_APP_URL=http://localhost:4000
POSTGRES_DB=nfcid
POSTGRES_USER=nfcid
POSTGRES_PASSWORD=nfcid_dev_password
